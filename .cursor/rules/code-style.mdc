 * 
 * @example
 * ```typescript
 * constructor(private authService: AuthService) {}
 * 
 * async login() {
 *   const result = await this.authService.authenticate(credentials);
 *   if (result.success) {
 *     // Handle successful login
 *   }
 * }
 * ```
 */
@Injectable({
  providedIn: 'root'
})
export class AuthService {
  
  /**
   * Authenticates user with provided credentials
   * 
   * @param credentials - User login credentials
   * @param credentials.username - User's username
   * @param credentials.password - User's password
   * @returns Promise that resolves to authentication result
   * 
   * @throws {AuthenticationError} When credentials are invalid
   * @throws {NetworkError} When API request fails
   * 
   * @example
   * ```typescript
   * try {
   *   const result = await authService.authenticate({
   *     username: 'john.doe',
   *     password: 'securePassword123'
   *   });
   *   console.log('Login successful:', result.user);
   * } catch (error) {
   *   console.error('Login failed:', error.message);
   * }
   * ```
   */
  public async authenticate(credentials: LoginCredentials): Promise<AuthResult> {
    // Implementation
  }
  
  /**
   * Checks if the current user has the specified role
   * 
   * @param role - Role to check for
   * @returns True if user has the role, false otherwise
   */
  public hasRole(role: UserRole): boolean {
    return this.currentUser?.roles.includes(role) ?? false;
  }
}
```

### Component Documentation
```typescript
/**
 * Data table component with sorting, filtering, and pagination
 * 
 * @example
 * ```html
 * <app-data-table 
 *   [data]="users"
 *   [columns]="userColumns"
 *   [sortable]="true"
 *   [filterable]="true"
 *   (rowSelected)="onUserSelected($event)"
 *   (dataChanged)="onUsersChanged($event)">
 * </app-data-table>
 * ```
 */
@Component({
  selector: 'app-data-table',
  templateUrl: './data-table.component.html',
  styleUrls: ['./data-table.component.css']
})
export class DataTableComponent<T> {
  /** Data to display in the table */
  @Input() public data: T[] = [];
  
  /** Column configuration for the table */
  @Input() public columns: TableColumn[] = [];
  
  /** Whether the table supports sorting */
  @Input() public sortable = false;
  
  /** Emitted when a row is selected */
  @Output() public rowSelected = new EventEmitter<T>();
}
```

