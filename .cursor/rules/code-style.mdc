# Code Style & Naming Conventions

## 🎨 TypeScript Style Guidelines

### File Naming Conventions
Follow Angular style guide naming patterns:

```
// Components
user-profile.component.ts
user-profile.component.html
user-profile.component.css
user-profile.component.spec.ts

// Services
data-management.service.ts
data-management.service.spec.ts

// Modules
feature-name.module.ts

// Models/Interfaces
user-profile.ts
api-response.ts

// Guards
auth-required.guard.ts

// Pipes
date-formatter.pipe.ts

// Directives
input-validator.directive.ts
```

### Class and Interface Naming
```typescript
// Classes use PascalCase
export class UserProfileComponent { }
export class DataManagementService { }
export class AuthRequiredGuard { }

// Interfaces use PascalCase with descriptive names
export interface UserProfile {
  id: number;
  username: string;
  email: string;
}

export interface ApiResponse<T> {
  success: boolean;
  data: T;
  message?: string;
}

// Enums use PascalCase
export enum UserRole {
  Admin = 'admin',
  User = 'user',
  Viewer = 'viewer'
}

// Constants use UPPER_SNAKE_CASE
export const DEFAULT_PAGE_SIZE = 20;
export const API_ENDPOINTS = {
  USERS: '/api/users',
  ASSETS: '/api/assets'
} as const;
```

### Variable and Method Naming
```typescript
export class ComponentExample {
  // Public properties use camelCase
  public isLoading = false;
  public userProfiles: UserProfile[] = [];
  public selectedUserId: number | null = null;
  
  // Private properties use camelCase with underscore prefix (optional)
  private readonly destroySubject = new Subject<void>();
  private apiBaseUrl = environment.API_URL;
  
  // Methods use camelCase with descriptive names
  public loadUserProfiles(): void {
    this.userService.getProfiles()
      .pipe(takeUntil(this.destroySubject))
      .subscribe(profiles => {
        this.userProfiles = profiles;
      });
  }
  
  public onUserSelected(userId: number): void {
    this.selectedUserId = userId;
    this.loadUserDetails(userId);
  }
  
  // Private methods use camelCase
  private loadUserDetails(userId: number): void {
    // Implementation
  }
  
  // Boolean methods/properties should be questions
  public isUserSelected(): boolean {
    return this.selectedUserId !== null;
  }
  
  public hasAdminRole(): boolean {
    return this.currentUser?.role === UserRole.Admin;
  }
}
```

## 🏗️ Component Structure Standards

### Component Property Organization
```typescript
@Component({
  selector: 'app-component-name',
  templateUrl: './component-name.component.html',
  styleUrls: ['./component-name.component.css']
})
export class ComponentNameComponent implements OnInit, OnDestroy {
  // 1. Static properties
  public readonly DEFAULT_ITEMS_PER_PAGE = 20;
  
  // 2. Input properties
  @Input() public data: DataType[] = [];
  @Input() public isReadOnly = false;
  
  // 3. Output properties
  @Output() public itemSelected = new EventEmitter<DataType>();
  @Output() public dataChanged = new EventEmitter<DataType[]>();
  
  // 4. ViewChild/ViewChildren
  @ViewChild('searchInput') public searchInput: ElementRef<HTMLInputElement>;
  @ViewChildren('listItems') public listItems: QueryList<ElementRef>;
  
  // 5. Public state properties
  public isLoading = false;
  public hasError = false;
  public errorMessage = '';
  public filteredData: DataType[] = [];
  
  // 6. Form properties
  public searchForm: FormGroup;
  public filterForm: FormGroup;
  
  // 7. Private properties
  private readonly destroySubject = new Subject<void>();
  private currentPage = 1;
  
  // 8. Constructor
  constructor(
    private dataService: DataService,
    private alertService: AlertService,
    private formBuilder: FormBuilder
  ) {
    this.initializeForms();
  }
  
  // 9. Lifecycle hooks
  public ngOnInit(): void {
    this.loadInitialData();
    this.setupFormSubscriptions();
  }
  
  public ngOnDestroy(): void {
    this.destroySubject.next();
    this.destroySubject.complete();
  }
  
  // 10. Public methods (alphabetically ordered)
  public clearFilters(): void { }
  public loadData(): void { }
  public onItemClick(item: DataType): void { }
  public refreshData(): void { }
  
  // 11. Private methods (alphabetically ordered)
  private applyFilters(): void { }
  private initializeForms(): void { }
  private loadInitialData(): void { }
  private setupFormSubscriptions(): void { }
}
```

### Template Style Guidelines

#### HTML Structure
```html
<!-- Use semantic HTML elements -->
<main class="main-content">
  <!-- Header section -->
  <header class="page-header">
    <h1 class="title">{{ pageTitle }}</h1>
    <div class="actions">
      <button class="button is-primary" 
              [disabled]="isLoading"
              (click)="onCreateNew()">
        <span class="icon">
          <i class="fas fa-plus"></i>
        </span>
        <span>Create New</span>
      </button>
    </div>
  </header>

  <!-- Filters section -->
  <section class="filters-section" 
           *ngIf="showFilters">
    <form [formGroup]="filterForm" 
          class="filter-form">
      <div class="field">
        <label class="label" for="search">Search</label>
        <div class="control has-icons-left">
          <input #searchInput
                 id="search"
                 class="input"
                 type="text"
                 placeholder="Search items..."
                 formControlName="search">
          <span class="icon is-left">
            <i class="fas fa-search"></i>
          </span>
        </div>
      </div>
    </form>
  </section>

  <!-- Content section -->
  <section class="content-section">
    <!-- Loading state -->
    <div *ngIf="isLoading" 
         class="loading-container">
      <app-progress-bar></app-progress-bar>
    </div>

    <!-- Data display -->
    <div *ngIf="!isLoading && !hasError" 
         class="data-container">
      <div *ngFor="let item of filteredData; trackBy: trackByItemId" 
           class="data-item"
           [class.selected]="item.id === selectedItemId"
           (click)="onItemSelected(item)">
        <h3 class="item-title">{{ item.name }}</h3>
        <p class="item-description">{{ item.description }}</p>
      </div>
    </div>

    <!-- Empty state -->
    <div *ngIf="!isLoading && !hasError && filteredData.length === 0" 
         class="empty-state">
      <p class="empty-message">No items found.</p>
    </div>

    <!-- Error state -->
    <div *ngIf="hasError" 
         class="error-container">
      <app-alert type="error" 
                 [message]="errorMessage">
      </app-alert>
    </div>
  </section>
</main>
```

#### Attribute Organization
```html
<!-- Order attributes: structural directives, property bindings, event bindings, other attributes -->
<button *ngIf="showButton"
        [disabled]="isDisabled"
        [class.is-loading]="isProcessing"
        (click)="onButtonClick()"
        class="button is-primary"
        type="button"
        data-cy="action-button">
  {{ buttonText }}
</button>
```

